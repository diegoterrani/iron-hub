[Unit]
Description=Iron Casino Bot (Telegram lab — BotYanis/Casino_bot)
Documentation=file:///home/ubuntu/iron-tools/iron-hub/services/casino-bot/DEPLOY.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/iron-tools/iron-hub/services/casino-bot
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
