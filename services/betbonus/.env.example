# Lab Kali: LLM local 27B (llama.cpp). OpenRouter fica opcional.
BETBONUS_LLM=qwen38-27b-hauhau
LLM_API_BASE=http://127.0.0.1:8082/v1
LLM_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition

# Postgres (optional — falls back to JSON files if not set)
# BETBONUS_DATABASE_URL=postgresql://betbonus:betbonus@localhost:5432/betbonus

# Redis cache (optional — falls back to no-cache if not set)
# BETBONUS_REDIS_URL=redis://localhost:6379/0

# Tokens das casas entram pelo Admin do dashboard (data/credentials.json, não commitar).
INTEGRITY_SKIP_BROWSER=0
PLAYWRIGHT_BROWSERS_PATH=.playwright
