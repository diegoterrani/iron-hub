IRON_HUB_USER=iron
IRON_HUB_PASS=change-me
IRON_HUB_SESSION_SECRET=generate-a-long-random-string
IRON_HUB_PORT=3900
# Produção: só localhost (nginx :443 é a porta pública)
IRON_HUB_BIND=127.0.0.1
# Opcional: secret TOTP base32 (preferível ativar pelo botão 2FA no Hub → data/totp.json)
# IRON_HUB_TOTP_SECRET=
# Graphify MCP — o Hub injeta no /mcp/graphify (não commitar o valor real)
# GRAPHIFY_API_KEY=
